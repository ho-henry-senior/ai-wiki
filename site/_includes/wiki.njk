{#- The wiki's layout, used by every content page, including the lane and
    tag pages. Built on the GOV.UK plugin's base layout, which provides the
    macros used here. -#}
{% extends "layouts/base.njk" %}

{#- Put metadata immediately after the h1, before the description. The
    header component normally renders title and description together, so
    render the title alone and preserve the plugin's description markup. -#}
{%- macro pageHeader() %}
  <header class="app-document-header">
    {{ appHeading({ caption: caption, title: title or ("Pages tagged ‘" + tag + "’") }) }}
    {{ pageMetadata() }}
    {%- if description %}
    <p class="govuk-body-l">{{ description | markdown("inline") | noOrphans | safe }}</p>
    {%- endif %}
  </header>
{%- endmacro %}

{#- The metadata line: an article's type and main goal, then dates and
    status (metadataParts in site/lanes.mjs). -#}
{%- macro pageMetadata() %}
  {%- set parts = { lane: lane, type: type, goal: goal, published: page.date if date, checked: checked, status: status } | metadataParts %}
  {%- if parts | length %}
  <p class="govuk-body-s app-page-details">
    {%- for part in parts %}
    {%- if part.href %}<a class="govuk-link" href="{{ part.href }}">{{ part.text }}</a>{% else %}{{ part.text }}{% endif %}{{ " · " if not loop.last }}
    {%- endfor %}
  </p>
  {%- endif %}
{%- endmacro %}

{%- macro pageDetails() %}
  {%- if tags | length %}
  <p class="govuk-body-s app-tags">Tags:
    {%- for tag in tags %}
    <a class="govuk-link" href="/tags/{{ tag | slugify }}/">{{ tag }}</a>{{ "," if not loop.last }}
    {%- endfor %}
  </p>
  {%- endif %}
  {%- set sections = content | contents %}
  {%- if sections | length %}
  <nav class="app-contents-list{{ " app-contents-list--letters" if sections | isLetterIndex }}" aria-labelledby="contents-title">
    <h2 class="app-contents-list__title" id="contents-title">Contents</h2>
    <ol>
      {%- for section in sections %}
      <li><a href="#{{ section.id }}">{{ section.text | safe }}</a></li>
      {%- endfor %}
    </ol>
  </nav>
  {%- endif %}
{%- endmacro %}

{#- Use the GOV.UK service-navigation component directly so its active section
    follows the page's lane, not a URL prefix or an article's main goal. -#}
{% from "govuk/components/service-navigation/macro.njk" import govukServiceNavigation %}
{% from "components/search/macro.njk" import appSearch with context %}
{% block govukHeader %}
  {{ appHeader(options.header) }}
  {{ govukServiceNavigation({
    classes: "app-service-navigation",
    attributes: options.serviceNavigation.attributes,
    ariaLabel: options.serviceNavigation.ariaLabel,
    menuButtonText: options.serviceNavigation.menuButtonText,
    menuButtonLabel: options.serviceNavigation.menuButtonLabel,
    navigationLabel: options.serviceNavigation.navigationLabel,
    navigationId: options.serviceNavigation.navigationId,
    navigationClasses: options.serviceNavigation.navigationClasses,
    serviceName: options.serviceNavigation.serviceName,
    serviceUrl: options.serviceNavigation.serviceUrl,
    navigation: options.serviceNavigation.navigation | sectionNavigation(lane, page.url),
    slots: {
      end: appSearch(options.serviceNavigation.search) if options.serviceNavigation.search.indexPath else options.serviceNavigation.slots.end
    }
  }) }}
  {% block phaseBanner %}
    {{ govukPhaseBanner(options.header.phaseBanner) if options.header.phaseBanner }}
  {% endblock %}
{% endblock %}

{#- One layout for every page. Pages in a lane, the lane pages and the tag
    pages have a sidebar; pages outside a lane have none. Lane pages list
    their collection (listCollection), and the tag pages list their pages
    or tags. -#}
{% block content %}
  {%- set sidebar = false %}
  {%- if sectionKey %}
    {%- set sidebar = collections.navigation | eleventyNavigation(sectionKey) | laneItems(page.url, sectionKey == "Articles", { url: laneUrls[sectionKey] }) %}
  {%- elif tag or tagIndex %}
    {%- set sidebar = collections.tags | tagItems(page.url) %}
  {%- endif %}

  {%- set mainColumn %}
    {{ pageHeader() }}
    {{ pageDetails() }}
    {{ appProseScope(content) if content }}
    {%- if listCollection == "articles" %}
    <ol class="app-document-list app-document-list--large">
      {%- for item in collections.articles %}
      {%- set parts = { lane: "articles", type: item.data.type, goal: item.data.goal } | metadataParts %}
      <li class="app-document-list__item">
        <h2 class="app-document-list__item-title"><a class="govuk-link" href="{{ item.url }}">{{ item.data.title }}</a></h2>
        {%- if item.data.description %}
        <p class="app-document-list__item-description">{{ item.data.description | markdown("inline") | safe }}</p>
        {%- endif %}
        {%- if parts | length %}
        <ul class="app-document-list__item-metadata">
          <li class="app-document-list__attribute">{% for part in parts %}{{ part.text }}{{ " · " if not loop.last }}{% endfor %}</li>
        </ul>
        {%- endif %}
      </li>
      {%- endfor %}
    </ol>
    {%- elif listCollection %}
    {{ appDocumentList({ classes: "app-document-list--large", items: collections[listCollection] }) }}
    {%- elif tag %}
    {{ appDocumentList({ classes: "app-document-list--large", items: collections[tag] }) }}
    {%- elif tagIndex %}
    <ul class="govuk-list">
      {%- for name in collections.tags %}
      <li><a class="govuk-link" href="/tags/{{ name | slugify }}/">{{ name }}</a> ({{ collections[name] | length }})</li>
      {%- endfor %}
    </ul>
    {%- endif %}
  {%- endset %}

  {% if sidebar %}
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-one-quarter-from-desktop">
        {{ xGovukSubNavigation({ items: sidebar }) }}
      </div>
      <div class="govuk-grid-column-three-quarters-from-desktop">
        {{ mainColumn | safe }}
      </div>
    </div>
  {% else %}
    {{ mainColumn | safe }}
  {% endif %}
{% endblock %}
