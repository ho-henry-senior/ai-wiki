{#- The wiki's layout. Goals and Reference pages get a sidebar for their
    lane; Articles show their date. Built on the GOV.UK plugin's base layout,
    which provides the macros used here. -#}
{% extends "layouts/base.njk" %}

{#- Under the title: a quiet metadata line with the checked date and
    completeness status, followed by tags and the contents list. Omit
    unknown fields and their separator. -#}
{%- macro pageDetails() %}
  {%- set knownStatuses = ["established", "developing", "stub"] %}
  {%- if checked or status in knownStatuses %}
  <p class="govuk-body-s app-page-details">
    {%- if checked %}Checked: {{ checked | govukDate }}{% endif %}
    {%- if checked and status in knownStatuses %} · {% endif %}
    {%- if status in knownStatuses %}Status: {{ status | capitalize }}{% endif %}
  </p>
  {%- endif %}
  {%- if tags | length %}
  <p class="govuk-body-s app-tags">Tags:
    {%- for tag in tags %}
    <a class="govuk-link" href="/tags/{{ tag | slugify }}/">{{ tag }}</a>{{ "," if not loop.last }}
    {%- endfor %}
  </p>
  {%- endif %}
  {%- set sections = content | contents %}
  {%- if sections | length %}
  <nav class="app-contents-list{{ " app-contents-list--letters" if sections | isLetterIndex }}" aria-labelledby="contents-title">
    <h2 class="app-contents-list__title" id="contents-title">Contents</h2>
    <ol>
      {%- for section in sections %}
      <li><a href="#{{ section.id }}">{{ section.text | safe }}</a></li>
      {%- endfor %}
    </ol>
  </nav>
  {%- endif %}
{%- endmacro %}

{#- Where the page sits: for example Home, Goals, Security, from the same
    navigation data as the sidebar (breadcrumbs in site/lanes.mjs). -#}
{% block beforeContent %}
  {%- set trail = collections.navigation | breadcrumbs(eleventyNavigation.key) %}
  {{ govukBreadcrumbs({
    classes: "govuk-!-display-none-print",
    items: trail
  }) if trail | length }}
{% endblock %}

{% block content %}
  {% if lane == "articles" %}
    {{ appDocumentHeader({ title: title, description: description, date: date }) }}
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-two-thirds-from-desktop">
        {{ pageDetails() }}
        {{ appProseScope(content) if content }}
      </div>
    </div>
  {% elif sectionKey %}
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-one-quarter-from-desktop">
        {{ xGovukSubNavigation({
          items: collections.navigation | eleventyNavigation(sectionKey) | laneItems(page.url)
        }) }}
      </div>
      <div class="govuk-grid-column-three-quarters-from-desktop">
        {{ appDocumentHeader({ title: title, description: description }) }}
        {{ pageDetails() }}
        {{ appProseScope(content) if content }}
      </div>
    </div>
  {% else %}
    {{ appDocumentHeader({ title: title, description: description }) }}
    {{ pageDetails() }}
    {{ appProseScope(content) if content }}
  {% endif %}
{% endblock %}
