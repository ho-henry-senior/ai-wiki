{
  "name": "ai-wiki",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "verify": "npm run format:check && npm run links",
    "format:check": "prettier --check \"**/*.md\"",
    "format": "prettier --write \"**/*.md\"",
    "links": "remark . --quiet --frail --no-stdout"
  },
  "devDependencies": {
    "prettier": "3.10.1",
    "remark-cli": "12.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-validate-links": "13.1.0"
  },
  "overrides": {
    "glob": "14.0.2",
    "minimatch": "11.0.1"
  },
  "remarkConfig": {
    "plugins": [
      "remark-frontmatter",
      "remark-gfm",
      "remark-validate-links"
    ]
  }
}
