{
  "name": "ai-wiki",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "verify": "npm run test:sitemap && npm run test:style && npm run test:site && npm run sitemap:check && npm run format:check && npm run links && npm run style",
    "format:check": "prettier --check \"**/*.md\" \".agents/skills/**/*.md\" \".github/workflows/**/*.md\"",
    "format": "prettier --write \"**/*.md\" \".agents/skills/**/*.md\" \".github/workflows/**/*.md\"",
    "links": "remark . .agents/skills .github/workflows --quiet --frail --no-stdout",
    "sitemap": "node scripts/sitemap.mjs --write",
    "sitemap:check": "node scripts/sitemap.mjs --check",
    "test:sitemap": "node --test scripts/sitemap.test.mjs",
    "style": "node scripts/style.mjs --strict",
    "test:style": "node --test scripts/style.test.mjs",
    "test:site": "node --test scripts/site-links.test.mjs scripts/search-ranking.test.mjs scripts/site-contents.test.mjs"
  },
  "devDependencies": {
    "prettier": "3.10.1",
    "remark": "15.0.1",
    "remark-cli": "12.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-validate-links": "13.1.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "glob": "14.0.2",
    "minimatch": "11.0.1"
  },
  "remarkConfig": {
    "plugins": [
      "remark-frontmatter",
      "remark-gfm",
      "remark-validate-links"
    ]
  }
}
